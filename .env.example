# Temporary prototype admin access. Use a long random value in production.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional durable pilot data store (Vercel KV / Upstash Redis REST).
# Without these, server records fall back to per-instance memory (dev/demo only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or the Upstash-native names:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: enables the live AI practice lab. Without this, the lab falls back to simulator mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
